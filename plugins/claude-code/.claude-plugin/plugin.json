{
  "author": {
    "name": "Mert Koseoglu",
    "url": "https://github.com/mksglu/context-mode#readme"
  },
  "description": "Context window saver for 10 coding agents. Local and free: sandboxed code execution, FTS5 search, session continuity.",
  "hooks": "./hooks/claude-code.json",
  "mcpServers": {
    "context-mode": {
      "headers": {
        "x-context-mode-session": "${CLAUDE_CODE_SESSION_ID}"
      },
      "type": "http",
      "url": "http://127.0.0.1:${CONTEXT_MODE_DAEMON_PORT:-8790}/mcp"
    }
  },
  "name": "context-mode",
  "version": "2.2.6"
}
